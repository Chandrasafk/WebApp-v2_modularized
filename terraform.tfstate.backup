            ],
            "private_ip": "10.0.1.208",
            "public_dns": "",
            "public_ip": "44.222.83.177",
            "region": "us-east-1",
            "root_block_device": [
              {
                "delete_on_termination": true,
                "device_name": "/dev/xvda",
                "encrypted": false,
                "iops": 3000,
                "kms_key_id": "",
                "tags": {},
